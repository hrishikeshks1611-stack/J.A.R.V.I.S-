<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#061326" android:centerColor="#0B3152" android:endColor="#061326" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#55CFFF" />
            <solid android:color="#00000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
